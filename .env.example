# Confluence Cloud (ex: https://your-company.atlassian.net/wiki)
CONF_BASE_URL=https://YOUR_SITE.atlassian.net/wiki

# Auth (email Atlassian + API token)
CONF_EMAIL=your_email@domain.com
CONF_API_TOKEN=your_api_token_here

# Cible
CONF_SPACE_ID=123456789

# Optionnel : page parent (si vous voulez ranger toute la KB sous une page "RoutePilot KB")
# CONF_PARENT_PAGE_ID=987654321